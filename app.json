{
  "expo": {
    "name": "FRI2PLAN Meals Preview",
    "slug": "fri2plan-meals-preview",
    "version": "1.1.7",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#fafaf8"
    },
    "scheme": "fri2plan-meals-preview",
    "plugins": [
      "./plugins/withRCTTurboModulePatch",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          },
          "android": {
            "targetSdkVersion": 36,
            "compileSdkVersion": 36
          }
        }
      ],
      "expo-dev-client",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#7c3aed",
          "sounds": [],
          "iosDisplayInForeground": true
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.582461718885-4614i560felc7gquqif8v8oamod4i68s"
        }
      ],
      "./plugins/withRNSTabBarPatch",
      "expo-apple-authentication",
      [
        "expo-updates",
        {
          "checkAutomatically": "ON_LOAD",
          "requestHeaders": {}
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ch.fri2plan.app.meals.preview",
      "buildNumber": "9",
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification",
          "fetch"
        ],
        "NSUserNotificationsUsageDescription": "FRI2PLAN envoie des rappels et notifications pour votre famille.",
        "NSFaceIDUsageDescription": "FRI2PLAN utilise Face ID pour vous connecter rapidement et en toute sécurité.",
        "NSCalendarsUsageDescription": "FRI2PLAN accède à votre calendrier pour synchroniser vos événements familiaux.",
        "NSCalendarsFullAccessUsageDescription": "FRI2PLAN accède à votre calendrier pour synchroniser vos événements familiaux dans les deux sens.",
        "NSRemindersUsageDescription": "FRI2PLAN peut créer des rappels pour vos tâches familiales.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "entitlements": {
        "aps-environment": "production",
        "com.apple.developer.applesignin": [
          "Default"
        ],
        "com.apple.developer.associated-domains": [
          "applinks:app.fri2plan.ch",
          "webcredentials:app.fri2plan.ch"
        ]
      },
      "usesAppleSignIn": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#7c3aed"
      },
      "package": "app.fri2plan.meals.preview",
      "versionCode": 1,
      "edgeToEdgeEnabled": false,
      "softwareKeyboardLayoutMode": "resize",
      "targetSdkVersion": 36,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ],
          "data": [
            {
              "scheme": "https",
              "host": "app.fri2plan.ch",
              "pathPrefix": "/invitation"
            }
          ]
        }
      ],
      "permissions": [
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR"
      ]
    },
    "extra": {
      "isMealsPreview": true,
      "eas": {
        "projectId": "a6f0b386-1025-4732-bf3d-65b0abde4410"
      }
    },
    "owner": "fri2plan",
    "updates": {
      "enabled": true,
      "fallbackToCacheTimeout": 0,
      "checkAutomatically": "ON_LOAD",
      "url": "https://u.expo.dev/a6f0b386-1025-4732-bf3d-65b0abde4410"
    }
  }
}
